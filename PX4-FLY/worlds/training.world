<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://iris</uri><name>iris</name><pose>0 0 0.3 0 0 0</pose></include>
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
    </physics>
    <gravity>0 0 -9.8066</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <gui><camera name="overview"><pose>-6 -7 5 0 0.4 0.85</pose></camera></gui>
    <model name="red_marker">
      <static>true</static><pose>8 0 1 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>1 1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1 2</size></box></geometry>
          <material><ambient>0.8 0.08 0.08 1</ambient><diffuse>0.8 0.08 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="green_marker">
      <static>true</static><pose>7 4 1.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>1 1 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1 3</size></box></geometry>
          <material><ambient>0.05 0.65 0.18 1</ambient><diffuse>0.05 0.65 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="blue_marker">
      <static>true</static><pose>7 -4 0.75 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>1 1 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1 1.5</size></box></geometry>
          <material><ambient>0.1 0.25 0.8 1</ambient><diffuse>0.1 0.25 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
