<?xml version="1.0"?>
<package format="3">
  <name>px4_fly_control</name>
  <version>0.1.0</version>
  <description>Keyboard Offboard control for the PX4-FLY Gazebo Classic quadrotor.</description>
  <maintainer email="local@example.com">PX4-FLY</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>px4_fly_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
