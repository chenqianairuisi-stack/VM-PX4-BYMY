<?xml version="1.0"?>
<sdf version="1.6">
  <model name="landing_lidar">
    <link name="link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>2.1733e-6</ixx><iyy>2.1733e-6</iyy><izz>1.8e-7</izz>
        </inertia>
      </inertial>
      <sensor name="laser" type="ray">
        <pose>0 0 0 0 1.57079633 0</pose>
        <ray>
          <scan><horizontal>
            <samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </horizontal></scan>
          <range><min>0.03</min><max>15</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="LaserPlugin" filename="libgazebo_lidar_plugin.so">
          <robotNamespace/>
          <min_distance>0.05</min_distance>
          <max_distance>15.0</max_distance>
        </plugin>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
